{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ApricotFramework.Grpc.ErrorDefinitions": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5400"
      }
    }
  },
  "StaticDiscovery": {
    "HostingType": "localhost",
    "DefaultGrpcProtocol": "http"
  },
  "GrpcClients": {
    "AllowInsecure": true,
    "DefaultDeadline": "00:00:10"
  }
}
