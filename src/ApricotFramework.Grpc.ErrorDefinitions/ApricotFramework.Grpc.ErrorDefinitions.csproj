<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The gRPC wire contract for ApricotFramework error definitions: classified errors travel in google.rpc.Status details with their payloads intact, translated in both directions, and a client interceptor rethrows a failed call as the exception the server threw.</Description>
    <PackageTags>grpc;error-handling;error-definitions;interceptors;microservices;protobuf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ApricotFramework.ErrorDefinitions" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Contract/**/*.proto" ProtoRoot="Contract" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped so a service in another language can implement the same contract. -->
    <None Include="Contract/apricot/errors/v1/errors.proto" Pack="true" PackagePath="protos/apricot/errors/v1/" Visible="false" />
  </ItemGroup>

</Project>
